# Sentra Discord Bot Environment Configuration

# Required: Your Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Database URL:
DATABASE_URL=sqlite+aiosqlite:///sentra.db

# Or PostgreSQL (Supabase / Neon / self-hosted):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Automatically register/sync slash commands on startup (true / false)
SYNC_COMMANDS=true

# Optional: Comma-separated list of premium guild IDs
PREMIUM_GUILD_IDS=

# Optional: Bot metadata shown in /about
ABOUT_DEVELOPER=Runxking and Modified by Stellar Ace
ABOUT_SUPPORT_URL=
ABOUT_REPO_URL=
